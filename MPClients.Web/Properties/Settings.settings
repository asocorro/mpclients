      <Value Profile="(Default)">xxxxxxxxxxxxxx</Value>
    </Setting>
    <Setting Name="SMTPPort" Type="System.String" Scope="Application">
      <Value Profile="(Default)">25</Value>
    </Setting>
    <Setting Name="SMTPSendUsing" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">2</Value>
    </Setting>
    <Setting Name="SMTPSendPassword" Type="System.String" Scope="Application">
      <Value Profile="(Default)">xxxxxxxxxxxxx</Value>
    </Setting>
    <Setting Name="SmtpMailServer" Type="System.String" Scope="Application">
      <Value Profile="(Default)">xxxxxxxxxxxxx</Value>
    </Setting>
    <Setting Name="SalespersonID" Type="System.String" Scope="Application">
