<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="MPClients.DataAccess" namespace="MPClients.DataAccess.Domain">
    <class name="Accreditation" table="Accreditation" >
    <id name="ID" type="System.Int32" column="Accreditation_ID">
        <generator class="identity"/>
    </id>
    <property name="CreditID" column="Credit_ID" type="System.String" not-null="true" length="50"/>
    <property name="InvoiceID" column="Invoice_ID" type="System.String" not-null="true" length="50"/>
    <property name="Applicationdate" column="Application_date" type="System.DateTime" not-null="true" />
    <property name="Amount" column="Amount" type="System.Decimal" not-null="true" />
 </class>
</hibernate-mapping>
