<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="MPClients.DataAccess" namespace="MPClients.DataAccess.Domain">
	<class name="VWOrders" table="VWOrders" >
		<id name="ID" type="System.Guid" column="ID">
			<generator class="assigned"/>
		</id>
		<property name="ClientId" column="Client_ID" type="System.String" not-null="true" />
		<property name="OrderId" column="OrderId" type="System.Guid" not-null="true" />
		<property name="Name" column="Name" type="System.String" not-null="false" length="20"/>
		<property name="Telephonenumber" column="Telephone_number" type="System.String" not-null="false" length="20"/>
		<property name="OrderDate" column="OrderDate" type="System.DateTime" not-null="true" />
		<property name="StatusDate" column="StatusDate" type="System.DateTime" not-null="false" />
		<property name="Status" column="Status" type="System.Int32" not-null="false" />
		<property name="OrderNo" column="OrderNo" type="System.String" not-null="false" length="20"/>
		<property name="DetailsCount" column="DetailsCount" update="0" type="System.Int32" not-null="false" />
    <property name="UserName" column="UserName" type="System.String"  length="50"/>
	</class>
</hibernate-mapping>
