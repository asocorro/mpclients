<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="MPClients.DataAccess" namespace="MPClients.DataAccess.Domain">
  <class name="News" table="News" >
    <id name="ID" type="System.Guid" column="ID">
      <generator class="assigned"/>
    </id>
    <property name="FromDate" column="FromDate" type="System.DateTime" not-null="true" />
    <property name="ToDate" column="ToDate" type="System.DateTime" not-null="true" />
    <property name="Title" column="Title" type="System.String" not-null="true" />
    <property name="Description" column="Description" type="System.String" not-null="true" />
  </class>
</hibernate-mapping>
